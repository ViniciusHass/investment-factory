# Copy to .env and set a unique local password.
POSTGRES_DB=investment_factory
POSTGRES_USER=investment
POSTGRES_PASSWORD=replace_with_local_secret
POSTGRES_PORT=5432

# The URL uses the db service name on the Docker network.
# Adjust the driver when the backend defines its uv/SQLAlchemy configuration.
DATABASE_URL=postgresql+psycopg://investment:replace_with_local_secret@db:5432/investment_factory
CORS_ORIGINS=http://localhost:5173
BACKEND_PORT=8000
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000
